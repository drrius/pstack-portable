{
  "name": "pstack-portable",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial cross-agent port of Lauren Tan's pstack workflows",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "install:global": "bun scripts/install.mjs",
    "uninstall:global": "bun scripts/uninstall.mjs",
    "install:tools": "cd skills/poteto-mode/scripts && bun install --frozen-lockfile",
    "audit:tools": "cd skills/poteto-mode/scripts && bun audit",
    "test": "bun test",
    "test:tools": "bun test",
    "typecheck:tools": "cd skills/poteto-mode/scripts && bun run typecheck",
    "verify": "bun scripts/verify.mjs",
    "verify:installed": "bun scripts/verify.mjs --installed",
    "check": "bun run verify && bun run bench:test && bun run bench:typecheck && bun run test:tools && bun run typecheck:tools && bun run audit:tools",
    "bench:preflight": "bun bench/cli.ts preflight",
    "bench:test": "bun test ./bench/lib",
    "bench:typecheck": "skills/poteto-mode/scripts/node_modules/.bin/tsc --project bench/tsconfig.json",
    "bench:smoke": "bun bench/cli.ts smoke",
    "bench:compare": "bun bench/cli.ts compare",
    "bench:report": "bun bench/cli.ts report",
    "bench:verify": "bun bench/verify.ts"
  },
  "license": "MIT"
}
